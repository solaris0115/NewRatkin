<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<FactionDef ParentName="FactionBase" Name="RatkinFactionBase" Abstract="True">
		<pawnSingular>ratkin</pawnSingular>
		<pawnsPlural>Ratkins</pawnsPlural>
		<categoryTag>Empire</categoryTag>
		<listOrderPriority>30</listOrderPriority>
		<settlementGenerationWeight>1</settlementGenerationWeight>
		<requiredCountAtGameStart>1</requiredCountAtGameStart>
		<maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
		<leaderTitle>monarch</leaderTitle>
		<factionNameMaker>NamerFaction_RatkinKingdom</factionNameMaker>
		<settlementNameMaker>NamerSettlement_RatkinKingdom</settlementNameMaker>
		<canSiege>true</canSiege>
		<canStageAttacks>true</canStageAttacks>
		<factionIconPath>Icon/RK_icon</factionIconPath>
		<techLevel>Industrial</techLevel>
		<!-- HAR/지도자 생성: GetRaceOfFaction 등이 참조. 미지정 시 세력 스폰·지도자 생성에서 NRE 가능 (RK_Faction_Caravan과 동일) -->
		<basicMemberKind>RatkinColonist</basicMemberKind>
		<melaninRange>0~0.3</melaninRange>
		<backstoryCategories>
			<li>Offworld</li>
		</backstoryCategories>
		<!-- TraderKinds -->
		<caravanTraderKinds>
			<li>RK_TraderKind_KingdomBulkGoods</li>			<!-- 원자재상 -->
			<li>RK_TraderKind_KingdomCombatSupplier</li>			<!-- 무기상 -->
			<li>RK_TraderKind_KingdomExotic</li>			<!-- 단순 희귀템 말고 무작위 유물과 일부 진귀한 아이템들로만 구성-->
			<li>RK_TraderKind_KingdomFoodMerchant</li>			<!-- 식자재상 -->
			<li>RK_TraderKind_KingdomTextileMerchant</li>			<!-- 원단상 -->
		</caravanTraderKinds>
		<visitorTraderKinds>
			<li>Visitor_Outlander_Standard</li>
		</visitorTraderKinds>
		<baseTraderKinds>
			<li>RK_TraderKind_Standard</li>
		</baseTraderKinds>
		<allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
		<disallowedMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">Structure_Animist</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
		</disallowedMemes>
		<structureMemeWeights>
			<Structure_TheistEmbodied MayRequire="Ludeon.RimWorld.Ideology">1</Structure_TheistEmbodied>
			<Structure_TheistAbstract MayRequire="Ludeon.RimWorld.Ideology">2</Structure_TheistAbstract>
			<Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Ideological>
			<Structure_Archist MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Archist>
			<Structure_OriginChristian MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginChristian>
		</structureMemeWeights>
		<maxPawnCostPerTotalPointsCurve>
			<points>
				<li>(0,35)</li>
				<li>(70, 50)</li>
				<li>(700, 100)</li>
				<li>(1300, 150)</li>
				<li>(100000, 10000)</li>
			</points>
		</maxPawnCostPerTotalPointsCurve>
		<pawnGroupMakers>
			<li>
				<kindDef>Combat</kindDef>
				<commonality>100</commonality>
				<maxTotalPoints>1000</maxTotalPoints>
				<options>
					<RatkinCombatant>20</RatkinCombatant>
					<RatkinSoldier>5</RatkinSoldier>
				</options>
			</li>
			<!-- 초반 혼합-->
			<li>
				<kindDef>Combat</kindDef>
				<commonality>100</commonality>
				<maxTotalPoints>1000</maxTotalPoints>
				<options>
					<RatkinDefender>5</RatkinDefender>
					<RatkinVanguard>10</RatkinVanguard>
					<RatkinCombatant>15</RatkinCombatant>
					<RK_PawnKind_StandardBearer>10</RK_PawnKind_StandardBearer>
				</options>
			</li>
			<!-- 중후반 군인-->
			<li>
				<kindDef>Combat</kindDef>
				<commonality>50</commonality>
				<options>
					<RatkinSoldier>30</RatkinSoldier>
					<RatkinEliteSoldier>5</RatkinEliteSoldier>
					<RatkinDemonMan>5</RatkinDemonMan>
					<RatkinDefender>15</RatkinDefender>
					<RatkinEliteGuardener>15</RatkinEliteGuardener>
				</options>
			</li>
			<!-- 중후반 디펜더, 가드너,기사-->
			<li>
				<kindDef>Combat</kindDef>
				<disallowedStrategies>
					<li>Siege</li>
				</disallowedStrategies>
				<commonality>30</commonality>
				<options>
					<RatkinEliteGuardener>30</RatkinEliteGuardener>
					<RatkinKnight>30</RatkinKnight>
					<RatkinEliteDefender>15</RatkinEliteDefender>
					<RK_PawnKind_StandardBearer>10</RK_PawnKind_StandardBearer>
				</options>
			</li>
			<!-- 중후반 엘리트 디펜더, 기사, 커맨더-->
			<li>
				<kindDef>Combat</kindDef>
				<disallowedStrategies>
					<li>Siege</li>
				</disallowedStrategies>
				<commonality>20</commonality>
				<options>
					<RatkinKnight>30</RatkinKnight>
					<RatkinEliteDefender>20</RatkinEliteDefender>
					<RatkinKnightCommander>5</RatkinKnightCommander>
				</options>
			</li>
			<li>
				<kindDef>Peaceful</kindDef>
				<options>
					<RatkinNoble>10</RatkinNoble>
					<RatkinColonist>20</RatkinColonist>
					<RatkinServant>15</RatkinServant>
					<RatkinEliteGuardener>10</RatkinEliteGuardener>
					<RatkinKnight>10</RatkinKnight>
					<RatkinPriest>10</RatkinPriest>
				</options>
			</li>
			<li>
				<kindDef>Trader</kindDef>
				<traders>
					<RatkinMerchant>15</RatkinMerchant>
					<RatkinNoble>8</RatkinNoble>
				</traders>
				<carriers>
					<Ratkin_KingHamster>6</Ratkin_KingHamster>
				</carriers>
				<guards>
					<RatkinCombatant>10</RatkinCombatant>
					<RatkinMercenaryLight>15</RatkinMercenaryLight>
					<RatkinSoldier>20</RatkinSoldier>
					<RatkinEliteGuardener>10</RatkinEliteGuardener>
					<RatkinDefender>10</RatkinDefender>
				</guards>
			</li>
			<li>
				<kindDef>Settlement</kindDef>
				<options>
					<RatkinNoble>3</RatkinNoble>
					<RatkinColonist>6</RatkinColonist>
					<RatkinServant>8</RatkinServant>
					<RatkinCombatant>5</RatkinCombatant>
					<RatkinEliteGuardener>8</RatkinEliteGuardener>
					<RatkinPriest>3</RatkinPriest>
				</options>
			</li>
		</pawnGroupMakers>
		<settlementTexturePath>Icon/RK_DefaultColony</settlementTexturePath>
		<apparelStuffFilter>
			<stuffCategoriesToAllow>
				<li>WeaponMetallic</li>
				<li>Fabric</li>
				<li>Leathery</li>
				<li>Woody</li>
			</stuffCategoriesToAllow>
		</apparelStuffFilter>
		<allowedCultures>
			<li>RK_Culture_Virtuard</li>
		</allowedCultures>
		<xenotypeSet>
			<xenotypeChances>
				<RK_XenoType_Ratkin MayRequire="Ludeon.RimWorld.Biotech">1</RK_XenoType_Ratkin>
				<Sanguophage MayRequire="Ludeon.RimWorld.Biotech">0</Sanguophage>
			</xenotypeChances>
		</xenotypeSet>
	</FactionDef>

	<FactionDef ParentName="RatkinFactionBase">
		<defName>Rakinia</defName>
		<label>ratkin kingdom</label>
		<description>랫킨 왕국입니다. 인간들 눈에 띄지 않도록 숨어서 살고 있으며 농경생활을 위주로 생활하는 비 침략적인 종족입니다.</description>
		<colorSpectrum>
			<li>(0.45, 0.50, 0.30)</li>
			<li>(0.65, 0.60, 0.20)</li>
		</colorSpectrum>
	</FactionDef>

	<FactionDef ParentName="FactionBase">
		<defName>RK_Faction_Pilgrims</defName>
		<label>pilgrims</label>
		<pawnSingular>pilgrim</pawnSingular>
		<pawnsPlural>pilgrims</pawnsPlural>
		<categoryTag>Pilgrims</categoryTag>
		<canSiege>false</canSiege>
		<canStageAttacks>false</canStageAttacks>
		<hidden>true</hidden>
		<description>A group of pilgrims seeking to venerate an ancient relic.</description>
		<factionIconPath>World/WorldObjects/Expanding/SettlementTemporary</factionIconPath>
		<factionNameMaker>NamerFactionOutlander</factionNameMaker>
		<settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
		<colorSpectrum>
			<li>(0.93, 0.39, 0.32)</li>
			<li>(0.35, 0.90, 0.57)</li>
			<li>(0.25, 0.66, 0.94)</li>
			<li>(0.98, 0.75, 0.37)</li>
			<li>(0.97, 0.62, 0.52)</li>
		</colorSpectrum>
		<generateNewLeaderFromMapMembersOnly>true</generateNewLeaderFromMapMembersOnly>
		<leaderTitle>leader</leaderTitle>
		<requiredCountAtGameStart>0</requiredCountAtGameStart>
		<mustStartOneEnemy>false</mustStartOneEnemy>
		<techLevel>Neolithic</techLevel>
		<basicMemberKind>RK_PawnKind_Pilgrim</basicMemberKind>
		<disallowedMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
		</disallowedMemes>
		<xenotypeSet>
			<xenotypeChances>
				<RK_XenoType_Ratkin MayRequire="Ludeon.RimWorld.Biotech">1</RK_XenoType_Ratkin>
				<Sanguophage MayRequire="Ludeon.RimWorld.Biotech">0</Sanguophage>
			</xenotypeChances>
		</xenotypeSet>
		<backstoryFilters>
			<li>
				<categories>
					<li>RK_Backstory_Pilgrim</li>
				</categories>
				<commonality>1</commonality>
			</li>
		</backstoryFilters>
		<settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
	</FactionDef>

	<!-- 히든 팩션1: 랫킨 캐러반 -->
	<!-- 상인 전용 팩션. hidden=true → HasGoodwill=false → 우호도 상승/하락 없음. factionHostileOnHarmByPlayer=true → 공격 시 적대 전환 -->
	<FactionDef ParentName="FactionBase">
		<defName>RK_Faction_Caravan</defName>
		<label>ratkin caravan</label>
		<pawnSingular>ratkin trader</pawnSingular>
		<pawnsPlural>ratkin traders</pawnsPlural>
		<categoryTag>RatkinCaravan</categoryTag>
		<hidden>true</hidden>
		<canSiege>false</canSiege>
		<canStageAttacks>false</canStageAttacks>
		<description>A traveling ratkin merchant caravan trading exotic goods.</description>
		<factionIconPath>Icon/RK_icon</factionIconPath>
		<factionNameMaker>NamerFaction_RatkinKingdom</factionNameMaker>
		<settlementNameMaker>NamerSettlement_RatkinKingdom</settlementNameMaker>
		<colorSpectrum>
			<li>(0.65, 0.50, 0.35)</li>
			<li>(0.75, 0.60, 0.25)</li>
		</colorSpectrum>
		<generateNewLeaderFromMapMembersOnly>true</generateNewLeaderFromMapMembersOnly>
		<leaderTitle>caravan master</leaderTitle>
		<requiredCountAtGameStart>0</requiredCountAtGameStart>
		<mustStartOneEnemy>false</mustStartOneEnemy>
		<techLevel>Industrial</techLevel>
		<!-- Alien Race: GetRaceOfFaction에서 basicMemberKind 사용. Trader pawnGroupMaker는 options가 없어 First() 예외 발생 방지 -->
		<basicMemberKind>RatkinMerchant</basicMemberKind>
		<!-- hidden=true → HasGoodwill=false → 우호도 변동 없음 (퀘스트/거래 등 영향 없음). 적대 전환은 factionHostileOnHarmByPlayer로 처리 -->
		<!-- 유랑 상인 전용 TraderKind (판매용 pawn은 IncidentWorker에서 별도 생성) -->
		<caravanTraderKinds>
			<li>RK_TraderKind_WanderingTrader</li>
		</caravanTraderKinds>
		<maxPawnCostPerTotalPointsCurve>
			<points>
				<li>(0,35)</li>
				<li>(70, 50)</li>
				<li>(700, 100)</li>
				<li>(1300, 150)</li>
				<li>(100000, 10000)</li>
			</points>
		</maxPawnCostPerTotalPointsCurve>
		<xenotypeSet>
			<xenotypeChances>
				<RK_XenoType_Ratkin MayRequire="Ludeon.RimWorld.Biotech">1</RK_XenoType_Ratkin>
				<Sanguophage MayRequire="Ludeon.RimWorld.Biotech">0</Sanguophage>
			</xenotypeChances>
		</xenotypeSet>
		<backstoryFilters>
			<li>
				<categories>
					<li>Offworld</li>
				</categories>
				<commonality>1</commonality>
			</li>
		</backstoryFilters>
		<pawnGroupMakers>
			<!-- 유랑 상인 그룹: 상인 + 호위병 (판매용 pawn은 IncidentWorker_RatkinWanderingTrader에서 별도 생성) -->
			<li>
				<kindDef>Trader</kindDef>
				<traders>
					<RatkinMerchant>15</RatkinMerchant>
					<RatkinNoble>8</RatkinNoble>
				</traders>
				<carriers>
					<Ratkin_KingHamster>6</Ratkin_KingHamster>
				</carriers>
				<guards>
					<RatkinMercenaryLight>15</RatkinMercenaryLight>
					<RatkinSoldier>20</RatkinSoldier>
					<RatkinDefender>10</RatkinDefender>
				</guards>
			</li>
			<!-- Odyssey 조난 등 Settlement 그룹 스폰용 — Trader만 있을 때 맵 생성 NRE 방지 -->
			<li>
				<kindDef>Settlement</kindDef>
				<options>
					<RatkinMerchant>5</RatkinMerchant>
					<RatkinMercenaryLight>10</RatkinMercenaryLight>
					<RatkinSoldier>10</RatkinSoldier>
					<RatkinDefender>8</RatkinDefender>
				</options>
			</li>
		</pawnGroupMakers>
		<settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
		<allowedCultures>
			<li>RK_Culture_Virtuard</li>
		</allowedCultures>
	</FactionDef>
</Defs>
