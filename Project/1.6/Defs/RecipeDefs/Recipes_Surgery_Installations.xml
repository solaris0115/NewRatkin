<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<RecipeDef Name="SurgeryInstallClothPartBase" ParentName="SurgeryInstallBodyPartArtificialBase"
		Abstract="True">
		<workAmount>1500</workAmount>
		<skillRequirements>
			<Medicine>3</Medicine>
		</skillRequirements>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Cloth</li>
					</thingDefs>
				</filter>
				<count>5</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Cloth</li>
			</thingDefs>
		</fixedIngredientFilter>
	</RecipeDef>

	<HediffDef ParentName="AddedBodyPartBase">
		<defName>RK_Hediff_FakeEar</defName>
		<label>fake ear</label>
		<labelNoun>a fake ear</labelNoun>
		<description>An installed fake ear.</description>
		<priceImpact>false</priceImpact>
		<addedPartProps>
			<partEfficiency>0.50</partEfficiency>
		</addedPartProps>
	</HediffDef>

	<RecipeDef ParentName="SurgeryInstallClothPartBase">
		<defName>RK_Recipe_InstallFakeEar</defName>
		<label>install fake ear</label>
		<description>Install a fake ear.</description>
		<descriptionHyperlinks>
			<ThingDef>Cloth</ThingDef>
		</descriptionHyperlinks>
		<jobString>Installing fake ear.</jobString>
		<appliedOnFixedBodyParts>
			<li>Ear</li>
		</appliedOnFixedBodyParts>
		<addsHediff>RK_Hediff_FakeEar</addsHediff>
		<uiIconThing>Cloth</uiIconThing>
	</RecipeDef>

	<HediffDef ParentName="AddedBodyPartBase">
		<defName>RK_Hediff_FakeTail</defName>
		<label>fake tail</label>
		<labelNoun>a fake tail</labelNoun>
		<description>An installed fake tail.</description>
		<priceImpact>false</priceImpact>
		<addedPartProps>
			<partEfficiency>0.60</partEfficiency>
		</addedPartProps>
	</HediffDef>

	<RecipeDef ParentName="SurgeryInstallClothPartBase">
		<defName>RK_Recipe_InstallFakeTail</defName>
		<label>install fake tail</label>
		<description>Install a fake tail.</description>
		<descriptionHyperlinks>
			<ThingDef>Cloth</ThingDef>
		</descriptionHyperlinks>
		<jobString>Installing fake tail.</jobString>
		<appliedOnFixedBodyParts>
			<li>RK_BodyPart_Tail</li>
		</appliedOnFixedBodyParts>
		<addsHediff>RK_Hediff_FakeTail</addsHediff>
		<uiIconThing>Cloth</uiIconThing>
	</RecipeDef>

	<RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
		<defName>RK_Recipe_InstallBionicTail</defName>
		<label>install bionic tail</label>
		<description>Install a bionic tail.</description>
		<descriptionHyperlinks>
			<ThingDef>RK_Thing_BionicTail</ThingDef>
			<HediffDef>RK_Hediff_BionicTail</HediffDef>
		</descriptionHyperlinks>
		<jobString>Installing bionic tail.</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>RK_Thing_BionicTail</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>RK_Thing_BionicTail</li>
			</thingDefs>
		</fixedIngredientFilter>
		<appliedOnFixedBodyParts>
			<li>RK_BodyPart_Tail</li>
		</appliedOnFixedBodyParts>
		<addsHediff>RK_Hediff_BionicTail</addsHediff>
	</RecipeDef>

	<HediffDef ParentName="AddedBodyPartBase">
		<defName>RK_Hediff_BionicTail</defName>
		<label>bionic tail</label>
		<description>An advanced artificial tail. It also has a small AI that automatically balances the user's missing.</description>
		<labelNoun>a bionic tail</labelNoun>
		<spawnThingOnRemoved>RK_Thing_BionicTail</spawnThingOnRemoved>
		<addedPartProps>
			<solid>true</solid>
			<partEfficiency>1.25</partEfficiency>
		</addedPartProps>
	</HediffDef>

	<HediffDef ParentName="AddedBodyPartBase">
		<defName>RK_Hediff_ArchotechTail</defName>
		<label>archotech ratkin tail</label>
		<labelNoun>an archotech ratkin tail</labelNoun>
		<description>An installed archotech ratkin tail. It senses posture and micro-movements to keep the bearer perfectly balanced, feels like living flesh, and is harder to damage than plasteel. If harmed, it repairs itself over time. Its inner workings are a mystery.</description>
		<descriptionHyperlinks><ThingDef>RK_Thing_ArchotechTail</ThingDef></descriptionHyperlinks>
		<spawnThingOnRemoved>RK_Thing_ArchotechTail</spawnThingOnRemoved>
		<addedPartProps>
			<solid>true</solid>
			<partEfficiency>1.50</partEfficiency>
			<betterThanNatural>true</betterThanNatural>
		</addedPartProps>
	</HediffDef>

	<RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
		<defName>RK_Recipe_InstallArchotechTail</defName>
		<label>install archotech ratkin tail</label>
		<description>Install an archotech ratkin tail.</description>
		<descriptionHyperlinks>
			<ThingDef>RK_Thing_ArchotechTail</ThingDef>
			<HediffDef>RK_Hediff_ArchotechTail</HediffDef>
		</descriptionHyperlinks>
		<jobString>Installing archotech ratkin tail.</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>RK_Thing_ArchotechTail</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>RK_Thing_ArchotechTail</li>
			</thingDefs>
		</fixedIngredientFilter>
		<appliedOnFixedBodyParts>
			<li>RK_BodyPart_Tail</li>
		</appliedOnFixedBodyParts>
		<addsHediff>RK_Hediff_ArchotechTail</addsHediff>
	</RecipeDef>
</Defs>