	<!-- TODO: 기본 아노말리에 포함 시키거나 또는 따로 탭을 만든다?.. 너무 탭 많지 않나. -->
	<!-- Ratnormaly는 따로 파일을 분리해서 복잡치 않도록 정리 -->
	<!-- 연구 항목은 Draw.io 파일 참고 -->

	<!-- 랫킨 연구 탭 -->
	<ResearchTabDef>
		<defName>RK_ResearchTab_Default</defName>
		<label>ratkin tech</label>
	</ResearchTabDef>

	<!-- 개발용 참고 샘플. 상속 받지도, 사용도 하지 말것 -->
	<ResearchProjectDef Name="RK_ResearchAttr_DontUse" Abstract="True">
		<defName>RK_Research_Sample</defName>
		<label>sample research</label>
		<description>연구 설명입니다.</description>
		<tab>RK_ResearchTab_Default</tab>
		<baseCost>600</baseCost>
		<techLevel>Medieval</techLevel>
		<researchViewX>0</researchViewX>
		<researchViewY>1</researchViewY>
		<!-- 선행 연구 -->
		<prerequisites>
			<li>RK_Research_Smithing</li>
			<li>RK_Research_Metallurgy</li>
		</prerequisites>
		<hiddenPrerequisites>
			<li>RK_Research_Carpentry</li>
		</hiddenPrerequisites>
		<tags>
			<li>RK_ResearchTag_MedievalBasic</li>
		</tags>
		<!-- 필요 연구 시설, 연구 장치-->
		<requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
		<requiredResearchFacilities>
			<li>MultiAnalyzer</li>
		</requiredResearchFacilities>
		<!-- 테크 프린트 -->
		<techprintCount MayRequire="Ludeon.RimWorld.Royalty">1</techprintCount>
		<techprintCommonality MayRequire="Ludeon.RimWorld.Royalty">1.0</techprintCommonality>
		<techprintMarketValue MayRequire="Ludeon.RimWorld.Royalty">1000</techprintMarketValue>
		<heldByFactionCategoryTags MayRequire="Ludeon.RimWorld.Royalty">
			<li>Empire</li>
		</heldByFactionCategoryTags>
		<!-- Biotech 메카나이터 여부와 분석물건 -->
		<requiresMechanitor>false</requiresMechanitor>
		<requiredAnalyzed>
			<li>MechanoidRemains</li>
		</requiredAnalyzed>
		<!-- Anormaly 연구 카테고리 -->
		<knowledgeCategory>RK_KnowledgeCategory</knowledgeCategory>
		<knowledgeCost>100</knowledgeCost>
		<!-- 오디세이 중력엔진 검사 여부 -->
		<!-- <requireGravEngineInspected>false</requireGravEngineInspected> -->
	</ResearchProjectDef>

