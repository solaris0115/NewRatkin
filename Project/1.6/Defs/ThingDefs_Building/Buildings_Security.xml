			<Steel>10</Steel>
			<WoodLog>20</WoodLog>
		</costList>
		<recipeMaker>
			<researchPrerequisite>RK_Research_Fortification</researchPrerequisite>
		</recipeMaker>
	</ThingDef>

	<ThingDef ParentName="BaseBullet">
		<defName>RK_Projectile_BallistaBoltNormal</defName>
		<label>ballista bolt (normal)</label>
		<graphicData>
			<texPath>Things/Projectile/RK_Texture_BallistaBolt</texPath>
			<drawSize>(2,2)</drawSize>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
		</graphicData>
		<thingClass>NewRatkin.Projectile_BallistaBoltAP</thingClass>
		<projectile Class="NewRatkin.ProjectileProperties_BallistaBoltAP">
			<maxPenetrationCount>2</maxPenetrationCount>
			<damageReduceRate>0.2</damageReduceRate>
			<damageDef>RangedStab</damageDef>
			<damageAmountBase>40</damageAmountBase>
			<armorPenetrationBase>0.5</armorPenetrationBase>
