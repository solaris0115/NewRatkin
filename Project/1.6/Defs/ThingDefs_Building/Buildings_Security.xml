	<!--================ 발리스타 ================-->
	<ThingDef ParentName="RK_BaseArtilleryBuilding">
		<defName>RK_Building_Ballista</defName>
		<label>ballista</label>
		<description>It is a machine that fires large arrows. It is designed to be easy to operate by Ratkin.</description>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<building>
			<turretGunDef>RK_Weapon_Ballista</turretGunDef>
			<turretTopDrawSize>1.15</turretTopDrawSize>
			<buildingTags>
				<li>Ratkin_Artillery</li>
			</buildingTags>
		</building>
		<uiIconPath>Things/Building/Security/RK_Texture_BallistaIcon</uiIconPath>
		<uiIconScale>1</uiIconScale>
		<researchPrerequisites>
			<li>RK_Research_Fortification</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="RK_BaseArtilleryWeapon">
		<defName>RK_Weapon_Ballista</defName>
		<label>ballista</label>
		<description>ballista bolt launcher. accurate and long-ranged.</description>
		<graphicData>
			<texPath>Things/Building/Security/RK_Texture_BallistaTurret</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<weaponTags>
			<li>Ratkin_Artillery</li>
		</weaponTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<warmupTime>15.0</warmupTime>
				<forcedMissRadius>0</forcedMissRadius>
				<minRange>3</minRange>
				<range>40</range>
				<burstShotCount>1</burstShotCount>
				<soundCast>BallistaShot</soundCast>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>
	</ThingDef>

	<!--================ 발리스타 탄 기본 ================-->
	<ThingCategoryDef>
		<defName>RK_ThingCategory_Ammo</defName>
		<label>ballista bolt</label>
		<parent>Manufactured</parent>
		<iconPath>UI/Icons/BallistaBolt</iconPath>
	</ThingCategoryDef>

	<ThingDef Name="RK_AmmoAttr_Base" ParentName="ResourceBase" Abstract="True">
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<tickerType>Normal</tickerType>
		<stackLimit>75</stackLimit>
		<techLevel>Medieval</techLevel>
		<statBases>
			<MaxHitPoints>60</MaxHitPoints>
			<MarketValue>20</MarketValue>
			<Mass>1</Mass>
			<Flammability>1.0</Flammability>
			<DeteriorationRate>1</DeteriorationRate>
		</statBases>
