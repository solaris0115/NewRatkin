<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 판금 갑옷 높은 날카로움, 둔탁함 방어력, 느려짐-->
	<ThingDef ParentName="RK_ApparelMakeableBase" Name="RK_ApparelAttr_Plate">
		<defName>RK_Plate</defName>
		<label>ratkin plate armor</label>
		<tradeTags>
			<li>RK_TradeTag_Armor</li>
		</tradeTags>
		<thingCategories>
			<li>RK_ApparelArmor</li>
		</thingCategories>
		<description>금속으로 만든 방어구입니다. 덧입을 수 있어 방어력을 한층 더 올릴 수 있습니다.</description>
		<graphicData>
			<texPath>Apparel/RK_Plate</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<ignoreThingDrawColor>false</ignoreThingDrawColor>
		</graphicData>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
			<researchPrerequisite>RK_Research_Metallurgy</researchPrerequisite>
			<recipeUsers Inherit="false">
				<li>RK_FueledSmithy</li>
				<li>RK_ElectricSmithy</li>
			</recipeUsers>
			<defaultIngredientFilter>
				<stuffCategoriesToAllow>
					<li>Metallic</li>
				</stuffCategoriesToAllow>
				<disallowedThingDefs>
					<li>Gold</li>
					<li>Silver</li>
				</disallowedThingDefs>
			</defaultIngredientFilter>
			<displayPriority>47360</displayPriority>
		</recipeMaker>
		<costList>
			<Steel>60</Steel>
		</costList>
		<costStuffCount>100</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<techLevel>Medieval</techLevel>
		<statBases>
			<MaxHitPoints>280</MaxHitPoints>
			<WorkToMake>35000</WorkToMake>
			<Mass>9</Mass>
			<StuffEffectMultiplierArmor>0.63</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.0</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.0</StuffEffectMultiplierInsulation_Heat>
			<ArmorRating_Sharp>0.25</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.3</ArmorRating_Blunt>
			<Flammability>0.0</Flammability>
			<EquipDelay>3</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<MeleeDodgeChance>-0.1</MeleeDodgeChance>
			<MoveSpeed>-0.65</MoveSpeed>
		</equippedStatOffsets>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
			<wornGraphicPath>Apparel/RK_Plate</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
			<layers>
				<li>Middle</li>
			</layers>
			<tags>
				<li>RK_Melee</li>
				<li>RK_Knight</li>
				<li>RK_2Tier</li>
				<li>RK_KnightCommander</li>
				<li>RK_HeavyArmor</li>
				<li>RoyalCombatGear</li>
			</tags>
		</apparel>
	</ThingDef>

	<!-- 판금 투구 공통 베이스 (텍스처만 상속에서 오버라이드) -->
