		</apparel>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
			<researchPrerequisite>RK_Research_Metallurgy</researchPrerequisite>
			<recipeUsers Inherit="false">
				<li>RK_FueledSmithy</li>
				<li>RK_ElectricSmithy</li>
			</recipeUsers>
			<defaultIngredientFilter>
				<stuffCategoriesToAllow>
					<li>Metallic</li>
				</stuffCategoriesToAllow>
				<disallowedThingDefs>
					<li>Gold</li>
					<li>Silver</li>
				</disallowedThingDefs>
			</defaultIngredientFilter>
			<displayPriority>47365</displayPriority>
		</recipeMaker>
	</ThingDef>

	<ThingDef ParentName="RK_ApparelAttr_PlateHelmBase" Name="RK_ApparelAttr_PlateHelmA">
		<defName>RK_PlateHelmA</defName>
		<graphicData>
			<texPath>Apparel/RK_PlateHelmet1</texPath>
