	<ThingDef ParentName="ApparelBase" MayRequire="Ludeon.RimWorld.Odyssey,Ludeon.RimWorld.Biotech">
		<defName>RK_Apparel_VacsuitChildren</defName>
		<label>kid vacsuit</label>
		<description>A protective suit designed for children. It keeps the user safe in the vacuum of space.</description>
		<generateAllowChance>0</generateAllowChance>
		<techLevel>Spacer</techLevel>
		<graphicData>
			<texPath>Apparel/Vacsuit/RK_Apparel_Vacsuit</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.8</drawSize>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<statBases>
			<WorkToMake>20000</WorkToMake>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>4.8</Mass>
			<Flammability>0.4</Flammability>
			<ArmorRating_Sharp>0.4</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.2</ArmorRating_Blunt>
			<ArmorRating_Heat>0.4</ArmorRating_Heat>
			<Insulation_Cold>70</Insulation_Cold>
			<Insulation_Heat>30</Insulation_Heat>
			<EquipDelay>14</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>0.25</MoveSpeed>
			<VacuumResistance>0.32</VacuumResistance>
			<CarryingCapacity>35</CarryingCapacity>
		</equippedStatOffsets>
		<thingCategories>
			<li>RK_Apparel</li>
		</thingCategories>
		<tradeTags>
			<li>RK_Apparel</li>
			<li>RK_Apparel_Rare</li>
			<li>RK_TradeTag_All</li>
		</tradeTags>
		<smeltable>true</smeltable>
		<apparel>
			<developmentalStageFilter>Child</developmentalStageFilter>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<wornGraphicPath>Apparel/Vacsuit/RK_Apparel_Vacsuit</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
			<layers>
				<li>Middle</li>
				<li>Shell</li>
				<li>BackPack</li>
			</layers>
			<tags>
				<li>RK_4Tier</li>
				<li>RK_ApparelTag_SpaceWear</li>
				<li>RK_ApparelTag_HideTail</li>
				<li>RK_ApparelTag_HighTech</li>
			</tags>
			<defaultOutfitTags>
				<li>Spacefarer</li>
			</defaultOutfitTags>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
			<soundWear>Wear_PowerArmor</soundWear>
			<soundRemove>Remove_PowerArmor</soundRemove>
			<drawData>
				<childScale>0.7</childScale>
			</drawData>
		</apparel>
		<colorGenerator Class="ColorGenerator_White" Inherit="False" />
		<costList>
			<ComponentIndustrial>3</ComponentIndustrial>
			<Steel>45</Steel>
			<Plasteel>10</Plasteel>
		</costList>
		<recipeMaker MayRequire="Ludeon.RimWorld.Biotech">
			<researchPrerequisite>RK_Research_OrbitalEquipment</researchPrerequisite>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<displayPriority>47235</displayPriority>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Smith</effectWorking>
			<soundWorking>Recipe_Smith</soundWorking>
			<recipeUsers>
				<li>FabricationBench</li>
			</recipeUsers>
		</recipeMaker>
	</ThingDef>

