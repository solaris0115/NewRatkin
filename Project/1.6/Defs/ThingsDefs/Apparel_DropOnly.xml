		<costStuffCount>25</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<statBases>
			<MaxHitPoints>85</MaxHitPoints>
			<WorkToMake>2500</WorkToMake>
			<Mass>0.1</Mass>
			<StuffEffectMultiplierArmor>0</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.65</StuffEffectMultiplierInsulation_Cold>
			<EquipDelay>0.5</EquipDelay>
		</statBases>
		<apparel>
			<bodyPartGroups>
				<li>UpperHead</li>
			</bodyPartGroups>
			<tags inherit="false">
				<li>RK_ApparelTag_DropOnly</li>
				<li>RK_ApparelTag_Santa</li>
			</tags>
			<defaultOutfitTags>
				<li>Worker</li>
				<li>Soldier</li>
			</defaultOutfitTags>
			<wornGraphicPath>Apparel/RK_SantaHat</wornGraphicPath>
			<layers>
				<li>Overhead</li>
			</layers>
		</apparel>
		<recipeMaker Inherit="False">
		</recipeMaker>
		<tradeability>Sellable</tradeability>
		<tradeTags Inherit="false">
		</tradeTags>
	</ThingDef>

