<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 산타외투 -->
	<ThingDef ParentName="RK_ApparelMakeableBase">
		<defName>RK_SantaRobe</defName>
		<label>santa robe</label>
		<description>산타들이 입는 로브입니다.</description>
		<graphicData>
			<texPath>Apparel/RK_SantaRobe</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<recipeMaker Inherit="False">
		</recipeMaker>
		<costStuffCount>85</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<techLevel>Medieval</techLevel>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToMake>10000</WorkToMake>
			<Mass>3</Mass>
			<StuffEffectMultiplierArmor>0.32</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>1.3</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
			<Insulation_Cold>13</Insulation_Cold>
			<EquipDelay>2.5</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<SocialImpact>0.05</SocialImpact>
		</equippedStatOffsets>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<defaultOutfitTags>
				<li>Worker</li>
				<li>Soldier</li>
			</defaultOutfitTags>
			<wornGraphicPath>Apparel/RK_SantaRobe</wornGraphicPath>
			<layers>
				<li>Shell</li>
			</layers>
			<tags inherit="false">
				<li>RK_ApparelTag_DropOnly</li>
				<li>RK_ApparelTag_Santa</li>
			</tags>
		</apparel>
		<tradeability>Sellable</tradeability>
		<tradeTags Inherit="false">
		</tradeTags>
	</ThingDef>

	<!-- 산타 모자 추위저항 +5 -->
