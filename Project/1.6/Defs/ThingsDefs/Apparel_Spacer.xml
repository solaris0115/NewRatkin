	<!-- RK_Apparel_VacsuitChildren → Apparel_Child.xml -->

	<!--
		Royalty ApparelArmorCataphractBase / HelmetCataphractBase 는 DLC XML 전용.
		Royalty·Odyssey 등이 꺼져도 로드되도록 코어 ArmorMachineableBase 계열 + 코어 PowerArmor 텍스처 경로(추상용 플레이스홀더) 사용.
		자식(RK_Apparel_SpaceArmor)이 그래픽·수치를 덮어씀. Ideology 노예/억압·Odyssey 진공 저항은 자식 equippedStatOffsets 의 MayRequire 로 DLC 켠 경우만 적용.
		연구는 자식 recipeMaker(RK_Research_CrusaderArmor 등)에서 지정.
	-->
	<ThingDef Name="RK_ApparelAttr_CataphractArmorBase" ParentName="ArmorMachineableBase" Abstract="True">
		<techLevel>Spacer</techLevel>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
		</recipeMaker>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Apparel/PowerArmor/PowerArmor</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<uiIconScale>1.25</uiIconScale>
		<generateCommonality>2</generateCommonality>
		<statBases>
			<WorkToMake>75000</WorkToMake>
			<MaxHitPoints>400</MaxHitPoints>
			<Mass>9</Mass>
			<Flammability>0.4</Flammability>
			<ArmorRating_Sharp>1.2</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.5</ArmorRating_Blunt>
			<ArmorRating_Heat>0.6</ArmorRating_Heat>
			<Insulation_Cold>70</Insulation_Cold>
			<Insulation_Heat>12</Insulation_Heat>
			<EquipDelay>17</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>-0.5</MoveSpeed>
			<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.3</SlaveSuppressionOffset>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.3</VacuumResistance>
		</equippedStatOffsets>
		<tradeTags>
			<li>HiTechArmor</li>
			<li>RK_TradeTag_ArmorHighTech</li>
			<li>RK_TradeTag_All</li>
		</tradeTags>
		<thingCategories>
			<li>RK_ApparelArmor</li>
		</thingCategories>
		<costList>
			<ComponentSpacer>6</ComponentSpacer>
			<Plasteel>150</Plasteel>
			<Uranium>50</Uranium>
		</costList>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Pawn/Humanlike/Apparel/PowerArmor/PowerArmor</wornGraphicPath>
			<layers>
				<li>Middle</li>
				<li>Shell</li>
			</layers>
			<defaultOutfitTags>
				<li>Soldier</li>
				<li>Spacefarer</li>
			</defaultOutfitTags>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
			<soundWear>Wear_PowerArmor</soundWear>
			<soundRemove>Remove_PowerArmor</soundRemove>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(0.9,0.9,0.9)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.33,0.33,0.33)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.65,0.65,0.65)</only>
				</li>
				<li>
					<weight>6</weight>
					<min>(0.3,0.3,0.3)</min>
					<max>(0.5,0.5,0.5)</max>
				</li>
			</options>
		</colorGenerator>
		<comps>
			<li Class="CompProperties_Biocodable"/>
		</comps>
		<thingSetMakerTags>
			<li>RewardStandardHighFreq</li>
		</thingSetMakerTags>
	</ThingDef>

