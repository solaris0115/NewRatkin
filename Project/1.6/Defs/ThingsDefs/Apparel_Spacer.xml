<Defs>
	<!-- 우주복 헬멧 -->
	<ThingDef ParentName="ArmorHelmetMakeableBase" MayRequire="Ludeon.RimWorld.Odyssey">
		<defName>RK_Apparel_VacsuitHelmet</defName>
		<label>vacsuit helmet</label>
		<description>A helmet that efficiently recycles the user's oxygen, allowing them to breathe in the vacuum of space for hours at a time. The process isn't perfectly efficient, so the user must periodically return to a pressurized environment.</description>
		<possessionCount>1</possessionCount>
		<generateAllowChance>0</generateAllowChance>
		<techLevel>Spacer</techLevel>
		<graphicData>
			<texPath>Apparel/Vacsuit/RK_Apparel_VacsuitHelmet</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<statBases>
			<WorkToMake>15000</WorkToMake>
			<MaxHitPoints>120</MaxHitPoints>
			<Mass>0.9</Mass>
			<Flammability>0.4</Flammability>
			<ArmorRating_Sharp>0.4</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.2</ArmorRating_Blunt>
			<ArmorRating_Heat>0.4</ArmorRating_Heat>
			<Insulation_Cold>10</Insulation_Cold>
			<Insulation_Heat>20</Insulation_Heat>
			<EquipDelay>4</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<ToxicEnvironmentResistance>0.8</ToxicEnvironmentResistance>
			<VacuumResistance>0.69</VacuumResistance>
			<AimingDelayFactor>-0.12</AimingDelayFactor>
			<ShootingAccuracyPawn>4</ShootingAccuracyPawn>
		</equippedStatOffsets>
		<smeltable>true</smeltable>
		<thingCategories>
			<li>RK_Apparel</li>
			<li>RK_Headgear</li>
		</thingCategories>
		<apparel>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<developmentalStageFilter>Child, Adult</developmentalStageFilter>
			<immuneToToxGasExposure>true</immuneToToxGasExposure>
			<canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
			<canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
			<canBeDesiredForIdeo>false</canBeDesiredForIdeo>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
			<wornGraphicPath>Apparel/Vacsuit/RK_Apparel_VacsuitHelmet</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
			<layers>
				<li>Overhead</li>
			</layers>
			<tags>
				<li>RK_4Tier</li>
				<li>RK_ApparelTag_SpaceWear</li>
				<li>RK_ApparelTag_HideEar</li>
				<li>RK_ApparelTag_HighTech</li>
			</tags>
			<defaultOutfitTags>
				<li>Spacefarer</li>
			</defaultOutfitTags>
		</apparel>
		<colorGenerator Class="ColorGenerator_White" Inherit="False" />
		<tradeTags>
			<li>RK_Apparel_Rare</li>
		</tradeTags>
		<costList>
			<DevilstrandCloth>10</DevilstrandCloth>
			<ComponentIndustrial>2</ComponentIndustrial>
			<Steel>40</Steel>
		</costList>
		<recipeMaker>
			<researchPrerequisite>RK_Research_OrbitalEquipment</researchPrerequisite>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<displayPriority>47237</displayPriority>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Smith</effectWorking>
			<soundWorking>Recipe_Smith</soundWorking>
			<recipeUsers Inherit="false">
				<li>FabricationBench</li>
			</recipeUsers>
		</recipeMaker>
	</ThingDef>

	<!-- 성인용 우주복 -->
	<ThingDef ParentName="ApparelMakeableBase" MayRequire="Ludeon.RimWorld.Odyssey">
