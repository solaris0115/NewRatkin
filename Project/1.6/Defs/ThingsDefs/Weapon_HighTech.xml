			</recipeUsers>
			<skillRequirements>
				<Crafting>10</Crafting>
			</skillRequirements>
			<displayPriority>78540</displayPriority>
		</recipeMaker>
		<comps Inherit="false">
			<li Class="SYS.CompProperties_WeaponExtention">
				<littleDown>True</littleDown>
				<northOffset>
					<position>(0.45,0,0.15)</position>
					<angle>-15</angle>
				</northOffset>
				<southOffset>
					<position>(-0.45,0.3,0.1)</position>
					<angle>35</angle>
				</southOffset>
				<eastOffset>
					<position>(0.45,0.3,-0.05)</position>
