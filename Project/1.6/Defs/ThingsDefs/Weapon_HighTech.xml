	<ThingDef>
		<defName>GunlancePreIgnition</defName>
		<label>ignition</label>
		<thingClass>NewRatkin.AttachableThing_GunlanceIgnition</thingClass>
		<category>Attachment</category>
		<tickerType>Normal</tickerType>
		<graphicData>
			<!-- 실제 렌더링은 AttachableThing_GunlanceIgnition에서 PreIgnitionA와 PreIgnitionB를 번갈아가며 사용 -->
			<!-- 여기서는 로드 시점 오류 방지를 위해 PreIgnitionA를 참조 -->
			<texPath>Things/Special/PreIgnitionA</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<altitudeLayer>PawnState</altitudeLayer>
		<useHitPoints>false</useHitPoints>
		<comps>
			<li Class="NewRatkin.CompProperties_AttachableIgnition">
				<positionOffset>(0.15, 0, 0.15)</positionOffset>
				<powerIncreasePerTick>0.02</powerIncreasePerTick>
				<maxPower>1</maxPower>
				<directionOffsetDistance>1.1</directionOffsetDistance>
				<preIgnitionBaseSize>2.5</preIgnitionBaseSize>
				<preIgnitionSizeMultiplier>4</preIgnitionSizeMultiplier>
				<preIgnitionMaxSize>2</preIgnitionMaxSize>
				<preIgnitionSizeScale>1.5</preIgnitionSizeScale>
				<preIgnitionHeightBase>1.1</preIgnitionHeightBase>
				<preIgnitionHeightReduction>0.2</preIgnitionHeightReduction>
			</li>
		</comps>
	</ThingDef>

	<ThingDef>
		<defName>GunlanceAfterIgnition</defName>
		<label>ignition</label>
