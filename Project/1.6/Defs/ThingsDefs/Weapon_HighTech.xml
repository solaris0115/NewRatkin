	<!-- 신규 데미지 유형 -->
	<ToolCapacityDef>
		<defName>RK_ToolCapacity_ChainSword</defName>
		<label>saw</label>
	</ToolCapacityDef>

	<ManeuverDef>
		<defName>RK_Maneuver_ChainSword</defName>
		<requiredCapacity>RK_ToolCapacity_ChainSword</requiredCapacity>
		<verb>
			<verbClass>Verb_MeleeAttackDamage</verbClass>
			<meleeDamageDef>RK_Damage_Torn</meleeDamageDef>
		</verb>
		<logEntryDef>MeleeAttack</logEntryDef>
		<combatLogRulesHit>Maneuver_Smash_MeleeHit</combatLogRulesHit>
		<combatLogRulesDeflect>Maneuver_Smash_MeleeDeflect</combatLogRulesDeflect>
		<combatLogRulesMiss>Maneuver_Smash_MeleeMiss</combatLogRulesMiss>
		<combatLogRulesDodge>Maneuver_Smash_MeleeDodge</combatLogRulesDodge>
	</ManeuverDef>

	<DamageDef>
		<defName>RK_Damage_Torn</defName>
		<label>torn</label>
		<workerClass>DamageWorker_Torn</workerClass>
		<externalViolence>true</externalViolence>
		<deathMessage>{0} has been cut to death.</deathMessage>
		<hediff>RK_Hediff_Torn</hediff>
		<hediffSkin>RK_Hediff_Torn</hediffSkin>
		<hediffSolid>Crush</hediffSolid>
		<harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
		<impactSoundType>RK_Impact_ChainSaw</impactSoundType>
		<armorCategory>Sharp</armorCategory>
		<overkillPctToDestroyPart>0~0.1</overkillPctToDestroyPart>
		<cutExtraTargetsCurve>
			<points>
				<li>0, 4</li>
				<li>0.6, 6</li>
				<li>0.9, 8</li>
				<li>1, 9</li>
			</points>
		</cutExtraTargetsCurve>
		<cutCleaveBonus>1.2</cutCleaveBonus>
	</DamageDef>

	<DamageDef>
		<defName>RK_Damage_BurnTorn</defName>
		<label>torn</label>
		<workerClass>DamageWorker_Torn</workerClass>
		<externalViolence>true</externalViolence>
		<deathMessage>{0} has been cut to death.</deathMessage>
		<hediff>RK_Hediff_Torn</hediff>
		<hediffSkin>RK_Hediff_Torn</hediffSkin>
		<hediffSolid>Crush</hediffSolid>
		<harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
		<impactSoundType>RK_Impact_ChainSaw</impactSoundType>
		<armorCategory>Heat</armorCategory>
		<overkillPctToDestroyPart>0~0.1</overkillPctToDestroyPart>
		<cutExtraTargetsCurve>
			<points>
				<li>0, 1</li>
				<li>0.6, 5</li>
				<li>0.9, 7</li>
				<li>1, 9</li>
			</points>
		</cutExtraTargetsCurve>
		<cutCleaveBonus>1.2</cutCleaveBonus>
	</DamageDef>

	<!-- 일반 피해 유형보다 부가 피해를 더 유발 -->
	<HediffDef ParentName="InjuryBase">
		<defName>RK_Hediff_Torn</defName>
		<label>torn</label>
		<labelNoun>a torn wound</labelNoun>
		<description>A torn wound.</description>
		<comps>
			<li Class="HediffCompProperties_TendDuration">
				<labelTendedWell>bandaged</labelTendedWell>
				<labelTendedWellInner>sutured</labelTendedWellInner>
				<labelSolidTendedWell>set</labelSolidTendedWell>
			</li>
			<li Class="HediffCompProperties_Infecter">
				<infectionChance>0.3</infectionChance>
			</li>
			<li Class="HediffCompProperties_GetsPermanent">
				<permanentLabel>torn scar</permanentLabel>
			</li>
		</comps>
		<injuryProps>
			<painPerSeverity>0.01875</painPerSeverity>
			<averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent>
			<bleedRate>0.08</bleedRate>
			<canMerge>false</canMerge>
			<destroyedLabel>Torn off</destroyedLabel>
			<destroyedOutLabel>Torn out</destroyedOutLabel>
		</injuryProps>
	</HediffDef>

	<!-- 체인소드 사운드 정의 -->
	<SoundDef>
		<defName>RK_Sound_ChainSaw</defName>
		<eventNames />
		<context>MapOnly</context>
		<maxSimultaneous>2</maxSimultaneous>
		<subSounds>
			<li>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>Weapon/RK_Sound_ChainSaw</clipPath>
					</li>
				</grains>
				<volumeRange>35~45</volumeRange>
				<pitchRange>
					<min>0.9</min>
					<max>1.1</max>
				</pitchRange>
			</li>
		</subSounds>
	</SoundDef>

	<!-- 체인소드 임팩트 사운드 타입 -->
	<ImpactSoundTypeDef>
		<defName>RK_Impact_ChainSaw</defName>
		<soundDef>RK_Sound_ChainSaw</soundDef>
		<playOnlyIfHitPawn>false</playOnlyIfHitPawn>
	</ImpactSoundTypeDef>
</Defs>