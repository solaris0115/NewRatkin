			</li>
		</comps>
	</ThingDef>

	<!-- Wyvern Fire Ability -->
	<AbilityDef>
		<defName>RK_WyvernFire_Ability</defName>
		<label>wyvern fire</label>
		<description>Unleash a devastating cone of explosive force.</description>
		<iconPath>Things/Special/WyvernFire</iconPath>
		<abilityClass>NewRatkin.Ability_WyvernFire</abilityClass>
		<cooldownTicksRange>2400</cooldownTicksRange>
		<cooldownPerCharge>False</cooldownPerCharge>
		<aiCanUse>true</aiCanUse>
		<ai_IsOffensive>true</ai_IsOffensive>
		<ai_SearchAOEForTargets>true</ai_SearchAOEForTargets>
		<warmupStartSound>RK_Sound_WyvernFireCast</warmupStartSound>
		<showOnCharacterCard>false</showOnCharacterCard>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<requireLineOfSight>true</requireLineOfSight>
			<range>5.5</range>
			<warmupTime>1.7</warmupTime>
			<soundCast>RK_Sound_WyvernFireShoot</soundCast>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="NewRatkin.CompProperties_AbilityWyvernFire">
				<range>6</range>
				<lineWidthEnd>5</lineWidthEnd>
				<damageDef>Bomb</damageDef>
				<damAmount>35</damAmount>
				<armorPenetration>0.7</armorPenetration>
				<canHitFilledCells>true</canHitFilledCells>
				<meleeCooldownTime>0.5</meleeCooldownTime>
				<cooldownEndSound>RK_Sound_WyvernFireOverheat</cooldownEndSound>
			</li>
			<li MayRequire="Ludeon.RimWorld.Anomaly" Class="NewRatkin.CompProperties_AbilityBurnerCustom">
				<numStreams>8</numStreams>
				<range>5.5</range>
				<coneSizeDegrees>18.2</coneSizeDegrees>
				<moteDef>RK_Mote_IncineratorBurst</moteDef>
				<barrelOffsetDistance>4</barrelOffsetDistance>
				<spawnOffsetDistance>-1</spawnOffsetDistance>
				<sizeReductionDistanceThreshold>2</sizeReductionDistanceThreshold>
				<lifespanTicks>10</lifespanTicks>
				<lifespanNoise>0</lifespanNoise>
				<rangeNoise>.2</rangeNoise>
				<effecterDef>RK_Effecter_BurnerUsed</effecterDef>
			</li>
		</comps>
	</AbilityDef>

	<ThingDef ParentName="MoteBase" MayRequire="Ludeon.RimWorld.Anomaly">
		<defName>RK_Mote_IncineratorBurst</defName>
		<thingClass>MoteDualAttached</thingClass>
		<altitudeLayer>MoteOverhead</altitudeLayer>
		<isSaveable>false</isSaveable>		<!-- because it's pure-vis, and weirdly constructed, it's better to not persist them at all -->
		<mote>
			<fadeInTime>0</fadeInTime>
			<fadeOutTime>1</fadeOutTime>
			<solidTime>999999</solidTime>
			<needsMaintenance>True</needsMaintenance>
			<rotateTowardsTarget>True</rotateTowardsTarget>
			<scaleToConnectTargets>False</scaleToConnectTargets>
			<fadeOutUnmaintained>True</fadeOutUnmaintained>
		</mote>
		<drawOffscreen>true</drawOffscreen>
		<graphicData>
			<texPath>Things/Mote/IncineratorFlameSheet</texPath>
			<graphicClass>Graphic_MoteWithAgeSecs</graphicClass>
			<shaderType>MoteIncineratorBeam</shaderType>
			<shaderParameters>
				<_GradientTex>/Things/Mote/IncineratorBeamGradient</_GradientTex>
				<_AgeScalarNoise>/Things/Mote/IncineratorBeamAgeNoise</_AgeScalarNoise>
				<_ScrollSpeedA>-4</_ScrollSpeedA>
				<_ScrollSpeedB>8</_ScrollSpeedB>
				<_Intensity>0</_Intensity>
				<_NumFrames>12</_NumFrames>
				<_FramesPerSec>30</_FramesPerSec>
			</shaderParameters>
			<drawSize>10</drawSize>
		</graphicData>
	</ThingDef>

	<EffecterDef MayRequire="Ludeon.RimWorld.Anomaly">
		<defName>RK_Effecter_BurnerUsed</defName>
		<children>
			<li>
				<subEffecterClass>SubEffecter_SprayerTriggeredDelayed</subEffecterClass>
				<fleckDef>Fleck_BurnerUsedSmoke</fleckDef>
				<initialDelayTicks>5</initialDelayTicks>
				<scale>.1~1</scale>
				<burstCount>2</burstCount>
				<spawnLocType>OnSource</spawnLocType>
				<absoluteAngle>True</absoluteAngle>
				<positionRadius>2</positionRadius>
				<positionRadiusMin>0</positionRadiusMin>
				<angle>0</angle>
				<speed>5</speed>
				<rotation>0~360</rotation>
				<fleckUsesAngleForVelocity>True</fleckUsesAngleForVelocity>
			</li>
			<li>
				<subEffecterClass>SubEffecter_SprayerTriggeredDelayed</subEffecterClass>
				<fleckDef>Fleck_BurnerUsedEmber</fleckDef>
				<initialDelayTicks>7</initialDelayTicks>
				<scale>.1~.5</scale>
				<burstCount>1~4</burstCount>
				<spawnLocType>OnSource</spawnLocType>
				<absoluteAngle>True</absoluteAngle>
				<positionRadius>3</positionRadius>
				<positionRadiusMin>0</positionRadiusMin>
				<angle>0</angle>
				<speed>.1~.9</speed>
				<rotation>0~360</rotation>
				<fleckUsesAngleForVelocity>True</fleckUsesAngleForVelocity>
			</li>
			<li>
				<subEffecterClass>SubEffecter_SprayerTriggeredDelayed</subEffecterClass>
				<fleckDef>Fleck_BurnerUsedEmberBlack</fleckDef>
				<initialDelayTicks>7</initialDelayTicks>
				<scale>.1~.3</scale>
				<burstCount>1</burstCount>
				<spawnLocType>OnSource</spawnLocType>
				<absoluteAngle>True</absoluteAngle>
				<positionRadius>3</positionRadius>
				<positionRadiusMin>0</positionRadiusMin>
				<angle>0</angle>
				<speed>.3~1.5</speed>
				<rotation>0~360</rotation>
				<fleckUsesAngleForVelocity>True</fleckUsesAngleForVelocity>
			</li>
		</children>
	</EffecterDef>

