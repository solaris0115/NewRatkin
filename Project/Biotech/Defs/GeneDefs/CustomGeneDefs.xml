	<!-- 귀여운 얼굴 -->
	<GeneDef>
		<defName>RK_Gene_CuteFace</defName>
		<label>cute face</label>
		<labelShortAdj>cute-faced</labelShortAdj>
		<description>Carriers of this gene have an adorable facial structure with rounded features, button nose, and expressive eyes that make them appear endearing and approachable.</description>
		<iconPath>UI/Icons/Genes/Gene_Beautiful</iconPath>
		<displayCategory>Beauty</displayCategory>
		<displayOrderInCategory>35</displayOrderInCategory>
		<endogeneCategory>Head</endogeneCategory>
		<selectionWeight>5.0</selectionWeight>
		<exclusionTags>
			<li>FaceType</li>
		</exclusionTags>
		<forcedHeadTypes>
			<li>RK_HeadType_Head1</li>
			<li>RK_HeadType_Head2</li>
			<li>RK_HeadType_Head3</li>
			<li>RK_HeadType_Head4</li>
			<li>RK_HeadType_Head5</li>
			<li>RK_HeadType_Head6</li>
			<li>RK_HeadType_Head7</li>
			<li>RK_HeadType_Head8</li>
		</forcedHeadTypes>
		<statFactors>
			<NegotiationAbility>0.80</NegotiationAbility>
			<TradePriceImprovement>0.90</TradePriceImprovement>
			<SocialImpact>1.20</SocialImpact>
		</statFactors>
		<biostatMet>0</biostatMet>
		<biostatCpx>1</biostatCpx>
		<symbolPack>
			<prefixSymbols>
				<li>
					<symbol>cute</symbol>
				</li>
				<li>
					<symbol>sweet</symbol>
				</li>
				<li>
					<symbol>charm</symbol>
				</li>
			</prefixSymbols>
			<suffixSymbols>
				<li>
					<symbol>charm</symbol>
				</li>
				<li>
					<symbol>cute</symbol>
				</li>
			</suffixSymbols>
		</symbolPack>
	</GeneDef>

