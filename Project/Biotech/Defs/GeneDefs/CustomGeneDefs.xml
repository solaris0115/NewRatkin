	     ======================================== -->

	<!-- 피부색 - 랫킨 전용 (순백색, 밝은 회색, 창백한 노란색 중 랜덤) -->
	<GeneDef ParentName="GeneSkinColorOverride" MayRequire="Ludeon.RimWorld.Biotech">
		<defName>RK_Skin_PureWhite</defName>
		<label>pure white skin</label>
		<labelShortAdj>snow-white</labelShortAdj>
		<description>Carriers of this gene have pure white skin characteristic of ratkin.</description>
		<skinColorOverride>(255, 255, 255)</skinColorOverride>
		<randomBrightnessFactor>0</randomBrightnessFactor>
		<displayOrderInCategory>93</displayOrderInCategory>
		<selectionWeight>1</selectionWeight>
		<randomChosen>true</randomChosen>
	</GeneDef>

