<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- ========================================
	     Ratkin Custom Genes
	     ======================================== -->

	<!-- 가벼운 체형 - Thin bodyType 고정 -->
	<GeneDef>
		<defName>RK_Gene_SmallBody</defName>
		<label>small body</label>
		<labelShortAdj>small-bodied</labelShortAdj>
		<description>Small, compact body that dodges better but hits weaker and carries less.</description>
		<iconPath>UI/Icons/Genes/Gene_BodyThin</iconPath>
		<displayCategory>Miscellaneous</displayCategory>
		<displayOrderInCategory>50</displayOrderInCategory>
		<endogeneCategory>BodyType</endogeneCategory>
		<bodyType>Thin</bodyType>
		<exclusionTags>
			<li>BodyType</li>
		</exclusionTags>
		<statOffsets>
			<CarryingCapacity>-15</CarryingCapacity>
		</statOffsets>
		<biostatMet>1</biostatMet>
		<biostatCpx>0</biostatCpx>
	</GeneDef>

