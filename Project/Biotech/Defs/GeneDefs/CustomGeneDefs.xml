	<!-- 전투 특성 -->
	<!-- TODO: 재빠름은 있지만 없어서 추가. 그리고 어중간한 회피율이라 가벼운 몸과 추가 -->
	<GeneDef>
		<defName>RK_Gene_Nimble</defName>
		<label>nimble</label>
		<labelShortAdj>nimble</labelShortAdj>
		<description>Carriers of this gene have heightened sensory receptor sensitivity, allowing them to better detect nearby threats and evade close-range attacks more effectively.</description>
		<iconPath>UI/Icons/Gene/RK_Icon_GeneNimble</iconPath>
		<displayCategory>Violence</displayCategory>
		<displayOrderInCategory>45</displayOrderInCategory>
		<statOffsets>
			<MoveSpeed>0.1</MoveSpeed>
		</statOffsets>
		<statFactors>
			<MeleeDodgeChance>1.3</MeleeDodgeChance>
		</statFactors>
		<biostatMet>-2</biostatMet>
		<biostatCpx>1</biostatCpx>
	</GeneDef>

	<!-- 근시 특성 -->
	<GeneDef>
		<defName>RK_Gene_PoorEyesight</defName>
		<label>poor eyesight</label>
		<labelShortAdj>poor eyesight</labelShortAdj>
		<description>Carriers of this gene have difficulty with precision aiming, resulting in slower aim time and research speed.</description>
		<iconPath>UI/Icons/Genes/Gene_Nearsighted</iconPath>
		<displayCategory>Miscellaneous</displayCategory>
		<displayOrderInCategory>55</displayOrderInCategory>
		<statFactors>
			<AimingDelayFactor>1.15</AimingDelayFactor>
			<ShootingAccuracyPawn>0.9</ShootingAccuracyPawn>
		</statFactors>
		<biostatMet>3</biostatMet>
		<biostatCpx>1</biostatCpx>
	</GeneDef>

	<!-- 약함 특성 -->
	<GeneDef>
		<defName>RK_Gene_FragilePain</defName>
		<label>fragile pain threshold</label>
		<labelShortAdj>fragile</labelShortAdj>
		<description>Carriers of this gene have a lower pain shock threshold and go down more easily from injuries.</description>
		<iconPath>UI/Icons/Genes/Gene_ExtraPain</iconPath>
		<displayCategory>Pain</displayCategory>
		<displayOrderInCategory>25</displayOrderInCategory>
		<statOffsets>
			<PainShockThreshold>-0.1</PainShockThreshold>
		</statOffsets>
		<biostatMet>1</biostatMet>
		<biostatCpx>1</biostatCpx>
	</GeneDef>

	<!-- 작업 능력 -->

	<GeneDef>
		<defName>RK_Gene_GoodGardening</defName>
		<label>good gardening</label>
		<labelShortAdj>green thumb</labelShortAdj>
		<description>Carriers of this gene work more efficiently with plants.</description>
		<iconPath>UI/Icons/Genes/Skills/Plants/Strong</iconPath>
		<displayCategory>Aptitudes</displayCategory>
		<displayOrderInCategory>8040</displayOrderInCategory>
		<statFactors>
			<!-- <PlantWorkSpeed>1.0</PlantWorkSpeed> 1이라서 주석 처리 -->
			<PlantHarvestYield>1.3</PlantHarvestYield>
		</statFactors>
		<biostatMet>-1</biostatMet>
		<biostatCpx>1</biostatCpx>
	</GeneDef>

	<!-- ========================================
