<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<XenotypeDef>
		<defName>RK_XenoType_Ratkin</defName>
		<label>ratkin</label>
		<description>기원을 알 수 없으나</description>
		<descriptionShort>일반적인 랫킨.</descriptionShort>
		<iconPath>UI/Icons/RK_Texture_XenoType</iconPath>
		<inheritable>true</inheritable>
		<!-- 랫킨 제노타입은 네임메이커 미사용 - backstory에 따라 정해지고, 
		이외 제노인 경우는 나중에 결정된 경우라서. 
		<chanceToUseNameMaker>1</chanceToUseNameMaker>
		<nameMaker>RK_RulePack_NamerPerson</nameMaker> -->
		<factionlessGenerationWeight>0</factionlessGenerationWeight>
		<genes>
		<!-- Immunity_Strong, ToxicEnvironmentResistance_Partial 제거됨 -->

		<!-- Custom Ratkin Genes -->

		<!-- 작은 신체 - 은신 정도 증가 -->
		<li>RK_Gene_SmallBody</li><!-- Met:0 CarryingCapacity -15 -->

		<!-- 전투 -->
		<li>RK_Gene_Nimble</li><!-- Met:-2 MeleeDodgeChance ×1.3, MoveSpeed +0.1 -->
		<li>RK_Gene_PoorEyesight</li><!-- Met:+3 Poor Eyesight - 장거리 사격 정확도 감소 -->
		<li>RK_Gene_FragilePain</li><!-- Met:+1 Cpx:-1 PainShockThreshold -0.1 -->

		<!-- 작업 능력 - 림월드 코어 기본 유전자 -->
		<li>AptitudeStrong_Mining</li><!-- 좋은 채굴 -->
		<li>AptitudeStrong_Plants</li><!-- 좋은 원예 -->
		<li>RK_Gene_GoodGardening</li><!-- 재배 속도 100%, 재배량 130% -->

		<!-- 외형 - 피부색 (순백/밝은 회색/창백한 노란색, exclusion으로 1개만 적용) -->
		<li>Skin_SheerWhite</li><!-- 순백색 - 림월드 바이오테크 기본 -->
		<li>Beard_NoBeardOnly</li><!-- 수염 없음 -->
		<li>RK_Gene_LargeEars</li><!-- Met:0 외형만 -->
		<li>RK_Gene_ThinTail</li><!-- Met:0 외형만 -->
		<li>RK_Gene_CuteFace</li><!-- Met:0 NegotiationAbility ×0.80, TradePriceImprovement ×0.90, SocialImpact ×1.20 -->
		</genes>
	</XenotypeDef>
</Defs>